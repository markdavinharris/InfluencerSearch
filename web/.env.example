# Server-only. The browser never sees these.
API_URL=http://localhost:8000          # FastAPI (Railway URL in prod)
INTERNAL_API_KEY=change-me             # same value as the API's INTERNAL_API_KEY

# Clerk (Google sign-in). In the Clerk dashboard: enable Google only, and restrict
# sign-ups to the allowlist / @coldspark.com domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Defence in depth, checked server-side on every page in addition to Clerk's own
# restrictions. Comma-separated. A user passes if their primary email's domain is in
# ALLOWED_EMAIL_DOMAINS or the full address is in ALLOWED_EMAILS.
ALLOWED_EMAIL_DOMAINS=coldspark.com
ALLOWED_EMAILS=

# Local development only: with NODE_ENV=development and no Clerk keys, auth is skipped.
