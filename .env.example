# Copy to .env (never commit .env).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/influence
# Tests use a separate database; it is wiped by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/influence_test
INTERNAL_API_KEY=change-me

# Classification: any OpenAI-compatible endpoint. Anthropic's is https://api.anthropic.com/v1
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_TOKEN_CAP=2000000

EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

X_BEARER_TOKEN=
X_MONTHLY_POST_BUDGET=8000   # ~80% of the Basic tier monthly read cap confirmed at signup

BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=coldspark-influence-mapper/0.1 (by u/yourname)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_CAP=30
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
NEWS_RSS_FEEDS=              # comma-separated, applied to every topic

ENABLED_COLLECTORS=x,bluesky,reddit,youtube,news,podcasts
ON_TOPIC_MIN_CONFIDENCE=0.6
SCORE_W_CENTRALITY=0.5
SCORE_W_ENGAGEMENT=0.3
SCORE_W_REACH=0.2
